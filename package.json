{
    "name": "stpeteai-safety-browser",
    "productName": "St. Pete AI Safety Browser",
    "version": "1.1.0",
    "description": "St. Pete AI Safety Browser - a scam-resistant Chromium browser",
    "main": "main.js",
    "author": "St. Pete AI",
    "license": "ISC",
    "type": "commonjs",
    "scripts": {
        "start": "launch.cmd",
        "test": "node --test test/safety-core.test.js",
        "scam-pages": "node test/scam-fixtures-server.js",
        "icon": "electron tools/make-icon.js",
        "dist": "electron-builder --win nsis --publish never",
        "release": "electron-builder --win nsis --publish always",
        "dist:portable": "electron-builder --win portable"
    },
    "build": {
        "appId": "org.stpeteai.safetybrowser",
        "productName": "St. Pete AI Safety Browser",
        "publish": [
            {
                "provider": "github",
                "owner": "Scrumbuddha",
                "repo": "stpeteai-safety-browser",
                "releaseType": "release"
            }
        ],
        "directories": {
            "output": "dist",
            "buildResources": "build"
        },
        "files": [
            "main.js",
            "preload.js",
            "app/**/*",
            "build/icon.png"
        ],
        "win": {
            "icon": "build/icon.png"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "St. Pete AI Safety Browser",
            "artifactName": "StPeteAI-Safety-Browser-Setup.exe",
            "runAfterFinish": true
        },
        "portable": {
            "artifactName": "StPeteAI-Safety-Browser-Portable-${version}.exe"
        }
    },
    "devDependencies": {
        "electron": "45.2.3",
        "electron-builder": "26.18.0"
    },
    "allowScripts": {
        "electron@45.2.3": true
    },
    "dependencies": {
        "electron-updater": "6.8.11"
    }
}
